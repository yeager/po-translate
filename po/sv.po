msgstr "Anpassad URL för LibreTranslate"

#: po_translate.py:903
msgid "Model for AI services (e.g., gpt-4o-mini, claude-3-haiku-20240307)"
msgstr "Modell för AI-tjänster (t.ex. gpt-4o-mini, claude-3-haiku-20240307)"

#: po_translate.py:904
msgid "Entries per API call (default: 10)"
msgstr "Antal poster per API-anrop (standard: 10)"


#: po_translate.py:854
msgid "positional arguments"
msgstr "positionsargument"

#: po_translate.py:855 po_translate.py:856
msgid "options"
msgstr "flaggor"

#: po_translate.py:864
msgid "po-translate - Batch translate .po and .ts files"
msgstr "po-translate - Massöversättning av .po- och .ts-filer"

#: po_translate.py:867
msgid ""
"\n"
"Examples:\n"
"  # Translate with free Lingva service\n"
"  po-translate --source en --target sv ./translations/\n"
"  \n"
"  # Translate with OpenAI\n"
"  po-translate --service openai --api-key sk-xxx --source en --target de ./po/\n"
"  \n"
"  # Dry run (don't save)\n"
"  po-translate --dry-run --source en --target fr messages.po\n"
"  \n"
"  # Translate single file\n"
"  po-translate --source en --target ja ./resources/strings.po\n"
"\n"
"Services (free):\n"
"  lingva        Google Translate frontend (default)\n"
"  mymemory      1000 words/day free\n"
"  libretranslate  Self-hosted or public instances\n"
"\n"
"Services (API key required):\n"
"  deepl         DeepL Pro (best for European languages)\n"
"  deepl-free    DeepL Free API\n"
"  google        Google Cloud Translation\n"
"  openai        GPT models (context-aware)\n"
"  anthropic     Claude models (context-aware)\n"
"        "
msgstr ""
"\n"
"Exempel:\n"
"  # Översätt med gratis Lingva-tjänst\n"
"  po-translate --source en --target sv ./translations/\n"
"\n"
"  # Översätt med OpenAI\n"
"  po-translate --service openai --api-key sk-xxx --source en --target de ./po/\n"
"\n"
"  # Torrkörning (spara inte)\n"
"  po-translate --dry-run --source en --target fr messages.po\n"
"\n"
"  # Översätt enstaka fil po-translate --source en --target ja ./resources/strings.po\n"
"\n"
"  Tjänster (gratis):\n"
"  lingva        Google Translate frontend (standard)\n"
"  mymemory      1000 ord/dag gratis\n"
"  libretranslate  Självhostade eller offentliga instanser\n"
"\n"
"  Tjänster (API-nyckel krävs):\n"
"  deepl         DeepL Pro (bäst för europeiska språk)\n"
"  deepl-free    DeepL Free API\n"
"  google        Google Cloud Translation\n"
"  openai        GPT-modeller (kontextmedvetna)\n"
"  anthropic     Claude-modeller (kontextmedvetna)\n"
"        "

#: po_translate.py:895
msgid "Files or directories to translate"
msgstr "Filer eller kataloger att översätta"

#: po_translate.py:896
msgid "Source language code (e.g., en)"
msgstr "Källspråkskod (t.ex. en)"

#: po_translate.py:897
msgid "Target language code (e.g., sv, de, fr). Defaults to system LANG."
msgstr "Målspråkkod (t.ex. sv, de, fr). Standard är systemets LANG."

#: po_translate.py:900
msgid "Translation service (default: lingva)"
msgstr "Översättningstjänst (standard: lingva)"

#: po_translate.py:901
msgid "API key for paid services"
msgstr "API-nyckel för betaltjänster"

#: po_translate.py:902

#. type: SH
#: data/man/po-translate.1:2
#, no-wrap
msgid "NAME"
msgstr "NAMN"

#. type: Plain text
#: data/man/po-translate.1:4
msgid "po-translate - Batch translate PO and TS files using AI"
msgstr "po-translate - Massöversätt PO och TS-filer med hjälp av AI"

#. type: SH
#: data/man/po-translate.1:4
#, no-wrap
msgid "SYNOPSIS"
msgstr "SYNOPSIS"

#. type: Plain text
#: data/man/po-translate.1:8
msgid "B<po-translate> [I<OPTIONS>] I<PATHS...>"
msgstr "B<po-translate> [I<OPTIONS>] I<SÖKVÄGAR...>"

#. type: SH
#: data/man/po-translate.1:8
#, no-wrap
msgid "DESCRIPTION"
msgstr "BESKRIVNING"

#. type: Plain text
#: data/man/po-translate.1:10
msgid ""
"B<po-translate> batch translates .po, .ts, and .xliff localization files "
"using AI or free translation services. It supports 8 translation backends "
"(Lingva, MyMemory, LibreTranslate, DeepL, Google, OpenAI, Anthropic), custom "
"glossaries, placeholder preservation, and dry-run mode."
msgstr ""
"B<po-translate> massöversätter .po-, .ts- och .xliff-lokaliseringsfiler med "
"hjälp av AI eller kostnadsfria översättningstjänster. Den stöder åtta "
"översättningsbackends (Lingva, MyMemory, LibreTranslate, DeepL, Google, "
"OpenAI, Anthropic), anpassade ordlistor, bevarande av platshållare och "
"testkörningsläge."

#. type: SH
#: data/man/po-translate.1:10
#, no-wrap
msgid "OPTIONS"
msgstr "FLAGGOR"

#. type: TP
#: data/man/po-translate.1:11
#, no-wrap
msgid "I<PATHS>"
msgstr "I<PATHS>"

#. type: Plain text
#: data/man/po-translate.1:14
msgid "Files or directories to translate."
msgstr "Filer eller kataloger att översätta."

#. type: TP
#: data/man/po-translate.1:14
#, no-wrap
msgid "B<-s>, B<--source> I<LANG>"
msgstr "B<-s>, B<--source> I<LANG>"

#. type: Plain text
#: data/man/po-translate.1:17
msgid "Source language code (e.g., en). Required."
msgstr "Kod för källspråket (t.ex., en). Krävs."

#. type: TP
#: data/man/po-translate.1:17
#, no-wrap
msgid "B<-t>, B<--target> I<LANG>"
msgstr "B<-t>, B<--target> I<LANG>"

#. type: Plain text
#: data/man/po-translate.1:20
msgid "Target language code (e.g., sv). Defaults to system LANG."
msgstr "Kod för målspråket (t.ex., sv). Standard är systemets LANG-variabel."

#. type: TP
#: data/man/po-translate.1:20
#, no-wrap
msgid "B<--service> I<SERVICE>"
msgstr "B<--service> I<SERVICE>"

#. type: Plain text
#: data/man/po-translate.1:23
msgid ""
"Translation service: lingva, mymemory, libretranslate, deepl, deepl-free, "
"google, openai, anthropic (default: lingva)."
msgstr ""
"Översättningstjänst: lingva, mymemory, libretranslate, deepl, deepl-free, "
"google, openai, anthropic (standard: lingva)."

#. type: TP
#: data/man/po-translate.1:23
#, no-wrap
msgid "B<--api-key> I<KEY>"
msgstr "B<--api-key> I<KEY>"

#. type: Plain text
#: data/man/po-translate.1:26
msgid "API key for paid services."
msgstr "API-nyckel för betaltjänster."

#. type: TP
#: data/man/po-translate.1:26
#, no-wrap
msgid "B<--url> I<URL>"
msgstr "B<--url> I<URL>"

#. type: Plain text
#: data/man/po-translate.1:29
msgid "Custom URL for LibreTranslate."
msgstr "Anpassad URL för LibreTranslate."

#. type: TP
#: data/man/po-translate.1:29
#, no-wrap
msgid "B<--model> I<MODEL>"
msgstr "B<--model> I<MODEL>"

#. type: Plain text
#: data/man/po-translate.1:32
msgid "Model for AI services (e.g., gpt-4o-mini, claude-3-haiku-20240307)."
msgstr "Modell för AI-tjänster (t.ex., gpt-4o-mini, claude-3-haiku-20240307)."

#. type: TP
#: data/man/po-translate.1:32
#, no-wrap
msgid "B<--batch-size> I<N>"
msgstr "B<--batch-size> I<N>"

#. type: Plain text
#: data/man/po-translate.1:35
msgid "Entries per API call (default: 10)."
msgstr "Poster per API-anrop (standard: 10)."

#. type: TP
#: data/man/po-translate.1:35
#, no-wrap
msgid "B<--glossary> I<FILE>"
msgstr "B<--glossary> I<FILE>"

#. type: Plain text
#: data/man/po-translate.1:38
msgid "CSV glossary file (source,target per line) for custom terms."
msgstr "Fil för CSV-ordlista (källa,mål per rad) för anpassade termer."

#. type: TP
#: data/man/po-translate.1:38
#, no-wrap
msgid "B<--dry-run>"
msgstr "B<--dry-run>"

#. type: Plain text
#: data/man/po-translate.1:41
msgid "Do not save changes."
msgstr "Spara inga ändringar."

#. type: TP
#: data/man/po-translate.1:41
#, no-wrap
msgid "B<--no-recursive>"
msgstr "B<--no-recursive>"

#. type: Plain text
#: data/man/po-translate.1:44
msgid "Do not search subdirectories."
msgstr "Sök inte i underkataloger."

#. type: TP
#: data/man/po-translate.1:44
#, no-wrap
msgid "B<-V>, B<--verbose>"
msgstr "B<-V>, B<--verbose>"

#. type: Plain text
#: data/man/po-translate.1:47
msgid "Show detailed progress."
msgstr "Visa detaljerat förlopp."

#. type: TP
#: data/man/po-translate.1:47
#, no-wrap
msgid "B<-v>, B<--version>"
msgstr "B<-v>, B<--version>"

#. type: Plain text
#: data/man/po-translate.1:50
msgid "Show version number and exit."
msgstr "Visa versionsnummer och avsluta."

#. type: TP
#: data/man/po-translate.1:50
#, no-wrap
msgid "B<--about>"
msgstr "B<--about>"

#. type: Plain text
#: data/man/po-translate.1:53
msgid "Show application info and exit."
msgstr "Visa applikationsinformation och avsluta."

#. type: SH
#: data/man/po-translate.1:53
#, no-wrap
msgid "EXAMPLES"
msgstr "EXEMPEL"

#. type: Plain text
#: data/man/po-translate.1:59
#, no-wrap
msgid ""
"po-translate -s en -t sv messages.po\n"
"po-translate -s en --service deepl --api-key KEY translations/\n"
"po-translate -s en -t de --service openai --model gpt-4o-mini *.po\n"
"po-translate -s en --glossary terms.csv --dry-run project/\n"
msgstr ""
"po-translate -s en -t sv messages.po\n"
"po-translate -s en --service deepl --api-key KEY translations/\n"
"po-translate -s en -t de --service openai --model gpt-4o-mini *.po\n"
"po-translate -s en --glossary terms.csv --dry-run project/\n"

